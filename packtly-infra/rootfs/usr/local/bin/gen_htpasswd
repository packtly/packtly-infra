#!/usr/bin/env bash
set -euo pipefail

# Use: gen_htpasswd.sh <USER> <PASS>

USER="${1:-}"
PASS="${2:-}"

HTPASSWD_FILE="/opt/packtly/public/.htpasswd"

if [[ -z "$USER" ]]; then
    echo "Error: user not specified" >&2
    exit 1
fi

if [[ -z "$PASS" ]]; then
    echo "Error: password not specified" >&2
    exit 1
fi

mkdir -p "$(dirname "$HTPASSWD_FILE")"

# Generate apache MD5 password
HASH="$(openssl passwd -apr1 "$PASS")"

# Remove existing entry for user
if [[ -f "$HTPASSWD_FILE" ]]; then
    grep -v "^${USER}:" "$HTPASSWD_FILE" > "${HTPASSWD_FILE}.tmp"
    mv "${HTPASSWD_FILE}.tmp" "$HTPASSWD_FILE"
fi

# Add user
echo "${USER}:${HASH}" >> "$HTPASSWD_FILE"

chmod 644 "$HTPASSWD_FILE"

echo "User '$USER' updated in $HTPASSWD_FILE"
